---
import alan from "@assets/devgames/alan-arnez.webp";
import roy from "@assets/devgames/roy-ayala.webp";
import { agenda, conversatorio } from "./programa";
import { speakers } from "./ponentes";
---

<section class="section shell" id="charlas" aria-labelledby="talks-title">
  <h2 id="talks-title">Charlas</h2>
  <div class="talk-grid">
    {
      agenda.map(([start, end, , , , speakerId]) => {
        if (!speakerId || speakerId === conversatorio.id) return null;
        const speaker = speakers[speakerId];
        const { name, role, title, topic, description, bio, photos } = speaker;
        const [photo, alternate] = photos;
        return (
          <article
            class="talk-card"
            id={speakerId}
            aria-labelledby={`${speakerId}-title`}
          >
            <img
              class="talk-portrait"
              src={photo.src}
              width={photo.width}
              height={photo.height}
              alt={`Retrato de ${name}`}
              loading="lazy"
            />
            <div class="talk-content">
              <p class="talk-meta">
                <time datetime={start}>{start}</time> –{" "}
                <time datetime={end}>{end}</time> · {topic}
              </p>
              <h3 id={`${speakerId}-title`}>{title}</h3>
              <p class="talk-byline">
                <>
                  <strong>{name}</strong>
                  <br />
                </>
                {role}
              </p>
              <p>{description}</p>
              <details>
                <summary>Sobre {name}</summary>
                <p>{bio}</p>
                {"website" in speaker && (
                  <p>
                    <a class="outline-button" href={speaker.website}>
                      Sitio web de {name}
                    </a>
                  </p>
                )}
                {alternate && (
                  <img
                    class="talk-alternate"
                    src={alternate.src}
                    width={alternate.width}
                    height={alternate.height}
                    alt={`Segundo retrato de ${name}`}
                    loading="lazy"
                  />
                )}
              </details>
            </div>
          </article>
        );
      })
    }
  </div>
  <article
    class="talk-card conversatorio"
    id={conversatorio.id}
    aria-labelledby="conversatorio-title"
  >
    <div class="talk-content">
      <p class="talk-meta">
        <time datetime={conversatorio.start}>{conversatorio.start}</time> –
        <time datetime={conversatorio.end}>{conversatorio.end}</time>
      </p>
      <h3 id="conversatorio-title">{conversatorio.title}</h3>
      <p>{conversatorio.question}</p>
    </div>
    <ul class="conversation-hosts" aria-label="Anfitriones">
      {
        [
          { name: "Roy Ayala", photo: roy },
          { name: "Alan Arnez", photo: alan },
        ].map(({ name, photo }) => (
          <li>
            <img
              src={photo.src}
              width={photo.width}
              height={photo.height}
              alt=""
              loading="lazy"
            />
            <strong>{name}</strong>
            <span>Anfitrión</span>
          </li>
        ))
      }
    </ul>
  </article>
</section>

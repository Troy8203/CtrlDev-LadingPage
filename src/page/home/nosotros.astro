---
import { Icons } from "@components/iconify/icons";
import Iconify from "@components/iconify/iconify.astro";
import Logo from "@assets/logo.svg";

type AboutCards = {
  icon: Icons;
  title: string;
  content: string;
};

const aboutCards: AboutCards[] = [
  {
    icon: Icons.PEOPLE,
    title: "Aprendizaje en Equipo",
    content:
      "Colabora con otros miembros y aprende de diferentes habilidades mientras construyen juntos su camino como desarrolladores.",
  },

  {
    icon: Icons.COMUNITY,
    title: "Comunidad Activa",
    content:
      "Conecta con otros aprendices, comparte ideas y participa en un entorno colaborativo que te impulsa a mejorar cada día.",
  },

  {
    icon: Icons.LEARNING,
    title: "Aprende Haciendo",
    content:
      "Refuerza tus conocimientos mediante ejercicios prácticos y retos semanales que te preparan para afrontar proyectos reales.",
  },
];
---

<div
  id="nosotros"
  class="h-svh md:h-screen snap-start w-full px-5 md:px-10 flex flex-col items-center justify-center gap-8 sm:gap-10 md:gap-36"
>
  <div class="flex flex-col justify-center gap-5 w-full max-w-6xl">
    <h2 class="text-accent font-bold text-5xl md:text-6xl">
      Acerca de Nosotros
    </h2>
    <p class="text-accent/85">
      Aprende Desarrollo Web desde cero con Nosotros. Un grupo de estudio donde
      compartimos conocimientos, practicamos con proyectos reales y nos ayudamos
      a crecer como desarrolladores.
    </p>
  </div>
  <div class="w-full max-w-6xl flex flex-col md:flex-row gap-5">
    {
      aboutCards.map((item) => (
        <div class="card card-body bg-base-200 flex-1">
          <div class="card-title">
            <Iconify icon={item.icon} color="primary" />
            <span class="text-primary">{item.title}</span>
          </div>
          <div>{item.content}</div>
        </div>
      ))
    }
  </div>
</div>

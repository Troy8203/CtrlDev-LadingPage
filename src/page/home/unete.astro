---
import Iconify from "@components/iconify/iconify.astro";
import { Icons } from "@components/iconify/icons";

const base = Astro.site ? Astro.site : "";
const currentTime = new Date().getHours() + ":" + new Date().getMinutes();
---

<section
  id="unete"
  class="h-svh md:h-screen snap-start w-full flex flex-col items-center text-center bg-gradient-to-b from-primary dark:from-primary/90 to-base-100 py-12"
>
  <div
    class="flex flex-col lg:flex-row items-center justify-center gap-5 flex-1 overflow-hidden py-10"
  >
    <div class="max-w-xl flex flex-col gap-6">
      <h2 class="text-4xl md:text-5xl font-bold text-accent">
        Unete a nuestra comunidad
      </h2>
      <p class="text-base md:text-lg text-accent/80">
        Conecta con otros aprendices, comparte ideas y participa en un entorno
        colaborativo que te impulsa a mejorar cada día.
      </p>
      <div>
        <a href={`${base}cursos`} class="btn btn-secondary">Ver Cursos</a>
      </div>
    </div>

    <!-- TODO: Refactor this phone mock -->
    <div
      class="bg-zinc-600 border-zinc-600 rounded-4xl border-4 overflow-hidden mx-5"
    >
      <div class="h-[600px] border-black rounded-4xl border-4 overflow-hidden">
        <div
          class="h-7 bg-white dark:bg-neutral-800 flex items-center justify-center relative"
        >
          <span class="absolute left-4 text-xs">{currentTime}</span>
          <div
            class="rounded-full w-16 h-5 bg-black flex items-center justify-end px-1"
          >
            <div
              class="w-3 h-3 rounded-full bg-radial from-neutral-900 from-40% via-blue-900 to-blue-500"
            >
            </div>
          </div>
          <div class="absolute right-4 flex gap-1">
            <Iconify icon={Icons.PHONE_SIGNAL} size={16} />
            <Iconify icon={Icons.PHONE_WIFI} size={16} />
            <Iconify icon={Icons.PHONE_BATTERY} size={16} />
          </div>
        </div>
        <img
          src="https://i.postimg.cc/fbDbTBWL/2025-12-28-21-24.png"
          alt="imagen-cursos"
          class="h-full w-auto"
        />
      </div>
    </div>
  </div>

  <!-- TODO: Refactor social links -->
  <div class="max-w-lg w-full">
    <a
      role="alert"
      class="alert cursor-pointer shadow-2xl"
      href="https://t.me/+Q7bDD2HZXnUyZTRh"
      target="_blank"
    >
      <div
        class="bg-gradient-to-b from-blue-400 to-blue-800 rounded-full p-1.5"
      >
        <Iconify icon={Icons.TELEGRAM} class="text-2xl text-white" />
      </div>
      <span
        >Únete a nuestro <span class="font-bold">canal de Telegram</span> para recibir
        noticias y próximos lanzamientos.</span
      >
      <button class="btn bg-blue-400"> Unirme </button>
    </a>
  </div>
</section>

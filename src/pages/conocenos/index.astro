---
import CardMember from "@components/card/card-member.astro";
import Footer from "@layouts/footer.astro";
import Layout from "@layouts/layout.astro";
import { members } from "src/constants/members";
---

<Layout>
  <div
    class="min-h-svh md:min-h-screen bg-[url(/assets/banner.svg)] bg-no-repeat bg-size-[auto_600px] md:bg-size-[auto_800px] lg:bg-contain bg-top w-full py-20 md:px-10 flex flex-col items-center gap-10"
  >
    <div class="flex flex-col items-center justify-center gap-5 min-h-56 mx-7">
      <h2 class="text-accent font-bold text-5xl md:text-6xl text-center">
        Conócenos
      </h2>
      <p class="max-w-2xl text-center text-accent/85">
        Las personas que organizan, enseñan y hacen crecer la comunidad
        Ctrl+Dev.
      </p>
    </div>
    <ul
      class="w-full max-w-6xl grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 justify-items-center gap-8 px-5"
    >
      {
        members.map((member) => (
          <li class="w-full flex justify-center">
            <CardMember {...member} />
          </li>
        ))
      }
    </ul>
  </div>
  <Footer />
</Layout>

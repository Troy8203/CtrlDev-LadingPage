---
import { Image } from "astro:assets";
import type { Miembro } from "src/types/models/miembro";

interface Props {
  miembro: Miembro;
}

const { nombre, rol, foto, presentacion, enlaces } = Astro.props.miembro;
const iniciales = nombre
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map((palabra) => Array.from(palabra)[0])
  .join("")
  .toLocaleUpperCase("es");
---

<article class="card card-body bg-base-200 items-start gap-4 h-full">
  {
    foto ? (
      <Image
        src={foto}
        alt=""
        width={160}
        height={160}
        fit="cover"
        class="size-20 rounded-full object-cover"
      />
    ) : (
      <span
        aria-hidden="true"
        class="grid size-20 place-items-center rounded-full bg-primary text-primary-content text-2xl font-bold"
      >
        {iniciales}
      </span>
    )
  }
  <div>
    <h2 class="card-title text-accent wrap-anywhere">{nombre}</h2>
    <p class="text-primary font-medium wrap-anywhere">{rol}</p>
  </div>
  {presentacion && <p class="wrap-anywhere">{presentacion}</p>}
  {
    enlaces && enlaces.length > 0 && (
      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {enlaces.map(({ etiqueta, url }) => (
          <li>
            <a
              class="link link-primary"
              href={url}
              aria-label={`${etiqueta} de ${nombre}`}
            >
              {etiqueta}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

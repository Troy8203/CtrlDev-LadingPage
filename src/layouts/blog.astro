---
import { coursesAvailable } from "src/constants";
import Footer from "./footer.astro";
import Layout from "./layout.astro";
import { getInitialsName } from "@utils/utils";
import Iconify from "@components/iconify/iconify.astro";
import { Icons } from "@components/iconify/icons";
import type { Contributor } from "../types/index";

type Index = {
  name: string;
  link: string;
};

type Props = {
  title: string;
  date: string;
  author: string;
  content?: Index[];
  colaboration?: Contributor[];
};

const base = Astro.site ? `${Astro.site.pathname}cursos` : "";
const currentPath = Astro.site ? `${Astro.url}` : "";

const { title, date, author, content, colaboration }: Props = Astro.props;
const authorAvatar = getInitialsName(author);
---

<Layout>
  <main class="h-screen overflow-y-scroll">
    <section class="flex-1 pt-10 px-4">
      <div
        class="w-full max-w-7xl mx-auto mt-14 rounded-xl grid grid-cols-1 lg:grid-cols-4 gap-x-10"
      >
        <div
          class="col-span-3 flex flex-col gap-5 mb-7 pb-7 border-b-2 border-primary/60"
        >
          <a
            href=""
            class="flex gap-1 text-purple-400"
            onclick="history.back()"
          >
            <Iconify icon={Icons.ARROW_LEFT} />
            <span>Regresar</span>
          </a>
          <h2
            class="bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent text-4xl font-bold"
          >
            {title}
          </h2>
          <div class="flex-1 flex items-center justify-between">
            <div class="flex items-center gap-4">
              <div class="avatar avatar-placeholder">
                <div
                  class="ring-primary ring-2 bg-neutral text-neutral-content w-9 rounded-full"
                >
                  <span class="text-xs">{authorAvatar}</span>
                </div>
              </div>
              <div>
                <p class="font-semibold">{author}</p>
                <p class="text-sm">Publicado el {date}</p>
              </div>
            </div>
            <button
              class="btn btn-accent btn-outline"
              onclick="my_modal_1.showModal()"
            >
              <Iconify icon={Icons.POST} size={19} />
              <span class="hidden md:inline-block">Compartir</span>
            </button>
          </div>
        </div>

        <aside class="row-span-2 hidden lg:block h-auto border-dashed">
          <div class="h-auto sticky top-20">
            <div class="flex flex-col self-start space-y-3 mb-5">
              {
                colaboration &&
                  colaboration.map((item) => (
                    <div
                      class="tooltip tooltip-primary tooltip-bottom"
                      data-tip="Únete a nosotros!"
                    >
                      <a
                        class="block rounded-4xl w-full h-16 p-0.5 overflow-clip transition-shadow"
                        href={item.link}
                        style={{
                          backgroundColor: item.color,
                          "--hover-color": item.color
                            ? `${item.color}8C`
                            : "#FFFFFF8C",
                        }}
                      >
                        <img
                          src={item.imageUri}
                          alt={`Logo ${item.name}`}
                          class="h-full w-auto object-cover object-center mx-auto"
                        />
                      </a>
                    </div>
                  ))
              }
            </div>

            <style>
              a.transition-shadow {
                transition:
                  box-shadow 0.3s ease-in-out,
                  all 0.3s ease-in-out;
              }
              a.transition-shadow:hover {
                box-shadow: 0px 0px 10px var(--hover-color);
              }
            </style>

            <div
              class="flex flex-col self-start space-y-3 [&>ul]:list-[square] [&>ul]:marker:text-primary"
            >
              {
                content && (
                  <>
                    <div class="flex flex-row items-center gap-2 w-full text-lg rounded-3xl p-1.5 px-3 bg-primary/20 text-primary">
                      <Iconify icon={Icons.INDEX} size={22} />
                      <h4 class="text-lg font-semibold">Contenido</h4>
                    </div>
                    <ul class="space-y-2 [&>li>a]:link [&>li>a]:link-hover [&>li>a]:link-accent px-10 mb-8">
                      {content.map((item) => (
                        <li>
                          <a class="text-sm" href={`#${item.link}`}>
                            {item.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )
              }
              <div
                class="flex flex-row items-center gap-2 w-full text-lg rounded-3xl p-1.5 px-3 bg-primary/20 text-primary"
              >
                <Iconify icon={Icons.COURSES} size={22} />
                <h4 class="text-lg font-semibold">Otros cursos</h4>
              </div>
              <ul
                class="space-y-2 [&>li>a]:link [&>li>a]:link-hover [&>li>a]:link-accent px-10"
              >
                {
                  coursesAvailable.map((item) => (
                    <li>
                      <a href={`${base}/${item.link}`}>{item.title}</a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </aside>

        <div
          class="col-span-3 prose prose-lg prose-slate max-w-none pb-20 md-content"
        >
          <slot />
        </div>
      </div>
    </section>

    <Footer />
  </main>

  <dialog id="my_modal_1" class="modal">
    <div class="modal-box bg-base-200">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4">
          <Iconify class="text-accent/20" icon={Icons.CLOSE} size={25} />
        </button>
      </form>
      <h3 class="text-lg font-bold mb-6">Compartir</h3>
      <div class="flex flex-col gap-3">
        <div class="w-full flex flex-row gap-2">
          <label
            class="input-group w-full input-md focus:ring-0 focus:border-0"
          >
            <input
              id="inputPath"
              type="text"
              class="input grow w-full bg-base-300!"
              placeholder="enlace"
              value={currentPath}
              disabled
            />
          </label>
          <button class="btn btn-primary" id="copyButton">
            <Iconify icon={Icons.COPY} size={18} />
            Copiar
          </button>
        </div>
        <div class="flex flex-row gap-2">
          <a
            class="border-2 border-white/10 flex flex-col items-center justify-center gap-1 flex-1 p-2 rounded-lg cursor-pointer hover:bg-white/10 transition-colors"
            href={`https://www.facebook.com/sharer/sharer.php?u=${currentPath}`}
            target="_blank"
          >
            <Iconify class="text-[#0866FF]" icon={Icons.FACEBOOK} size={20} />
            <span class="text-sm">Facebook</span>
          </a>
          <a
            class="border-2 border-white/10 flex flex-col items-center justify-center gap-1 flex-1 p-2 rounded-lg cursor-pointer hover:bg-white/10 transition-colors"
            href={`https://t.me/share/url?url=${currentPath}&text=${title}`}
            target="_blank"
          >
            <Iconify class="text-[#26A5E4]" icon={Icons.TELEGRAM} size={20} />
            <span class="text-sm">Telegram</span>
          </a>
          <a
            class="border-2 border-white/10 flex flex-col items-center justify-center gap-1 flex-1 p-2 rounded-lg cursor-pointer hover:bg-white/10 transition-colors"
            href={`https://api.whatsapp.com/send?text=${currentPath}`}
            target="_blank"
          >
            <Iconify class="text-[#25D366]" icon={Icons.WHATSAPP} size={20} />
            <span class="text-sm">Whatsapp</span>
          </a>
          <a
            class="border-2 border-white/10 flex flex-col items-center justify-center gap-1 flex-1 p-2 rounded-lg cursor-pointer hover:bg-white/10 transition-colors"
            href={`https://www.tiktok.com/share?url=${currentPath}`}
            target="_blank"
          >
            <Iconify icon={Icons.TIKTOK} size={20} />
            <span class="text-sm">TikTok</span>
          </a>
        </div>
      </div>
    </div>
  </dialog>

  <script type="module">
    const input = document.getElementById("inputPath");
    const button = document.getElementById("copyButton");

    button.addEventListener("click", () => {
      navigator.clipboard.writeText(input.value).catch((err) => {
        console.error("Error al copiar: ", err);
      });
    });
  </script>
</Layout>

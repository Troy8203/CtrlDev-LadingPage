---
import Logo from "../assets/logo-white.svg";
import Iconify from "../components/iconify/iconify.astro";
import { Icons } from "../components/iconify/icons";

const base = Astro.site ? Astro.site : "";
---

<div
  class="navbar bg-transparent backdrop-blur-sm shadow-2xl px-2 lg:px-28 z-10 absolute top-0"
>
  <div class="navbar-start">
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
        <Iconify icon={Icons.MENU} />
      </div>
      <ul
        tabindex="0"
        class="menu menu-md dropdown-content bg-base-200 rounded-box z-20 mt-7 w-56 p-2 shadow-2xl"
      >
        <li><a href=`${base}`>Inicio</a></li>
        <li><a href=`${base}#nosotros`>Nosotros</a></li>
        <li><a href=`${base}#unete`>Cursos</a></li>
        <li><a href=`${base}#unete`>Únete</a></li>
        <div class="divider my-1"></div>
        <div class="pb-3 flex flex-col gap-2 items-center">
          <p class="px-3 font-bold w-full">Tema</p>
          <div class="join gap-0 flex-1">
            <input
              type="radio"
              name="theme-dropdown"
              checked="checked"
              class="theme-controller join-item btn btn-sm"
              aria-label="Sistema"
              value="default"
            />

            <input
              type="radio"
              name="theme-dropdown"
              class="theme-controller join-item btn btn-sm"
              aria-label="Claro"
              value="light"
            />

            <input
              type="radio"
              name="theme-dropdown"
              class="theme-controller join-item btn btn-sm"
              aria-label="Oscuro"
              value="dark"
            />
          </div>
        </div>
      </ul>
    </div>
    <Logo class="h-10 w-auto hidden lg:block" />
  </div>
  <div class="navbar-end flex">
    <ul
      class="menu menu-horizontal px-1 [&>li>a]:hover:bg-base-300 hidden lg:flex items-center justify-center gap-1"
    >
      <li><a href=`${base}`>Inicio</a></li>
      <li><a href=`${base}#nosotros`>Nosotros</a></li>
      <li><a href=`${base}#unete`>Cursos</a></li>
      <li class="bg-secondary rounded-2xl">
        <a href=`${base}#unete`>Únete</a>
      </li>
      <li class="bg-accent/10 rounded-2xl">
        <div class="dropdown dropdown-hover dropdown-end">
          <div tabindex="0" role="button">
            <Iconify class="swap-off" icon={Icons.PALETTE} />
          </div>
          <ul
            tabindex="-1"
            class="dropdown-content bg-base-300 rounded-3xl z-1 w-36 shadow-2xl"
          >
            <div class="join join-vertical w-full p-0">
              <input
                type="radio"
                name="theme-dropdown"
                checked="checked"
                class="theme-controller join-item btn btn-sm"
                aria-label="Sistema"
                value="default"
              />

              <input
                type="radio"
                name="theme-dropdown"
                class="theme-controller join-item btn btn-sm"
                aria-label="Claro"
                value="light"
              />

              <input
                type="radio"
                name="theme-dropdown"
                class="theme-controller join-item btn btn-sm"
                aria-label="Oscuro"
                value="dark"
              />
            </div>
          </ul>
        </div>
      </li>
    </ul>
    <Logo class="h-10 w-auto mx-2 block lg:hidden" />
  </div>
</div>
